# Orchestration LLM used by the Jev Agent Framework agent.
# If unset, Jev falls back to a local router that still calls Codex tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Codex CLI uses ChatGPT login or an API key from the environment.
# The adapter never hardcodes credentials; it inherits the process environment.
# OPENAI_API_KEY is also the usual key Codex looks for.

# Optional Codex adapter overrides
# CODEX_EXECUTABLE=codex
# CODEX_DEFAULT_SANDBOX=workspace-write
# CODEX_TIMEOUT_SECONDS=300
