# Orchestration LLM used by the Jev Agent Framework agent.
# If unset, Jev falls back to a local router that still calls coding-worker tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Active coding worker: Codex | Claude | GrokBuild | Cline
JEV_CODING_STRATEGY=Codex

# Worker CLIs inherit the process environment. Do not commit secrets.
# OPENAI_API_KEY          Codex / some Cline providers
# ANTHROPIC_API_KEY       Claude Code (especially --bare) and Cline -P anthropic
# XAI_API_KEY             Grok Build

# Optional executable overrides
# CODEX_EXECUTABLE=codex
# CLAUDE_EXECUTABLE=claude
# GROK_EXECUTABLE=grok
# CLINE_EXECUTABLE=cline
# CODEX_DEFAULT_SANDBOX=workspace-write
# CODEX_TIMEOUT_SECONDS=300
