# Optional: Jev Agent Framework *orchestration* LLM only.
# Unrelated to Codex / Claude / Grok / Cline. Those workers use subscription login.
# If unset, Jev uses a local fallback router that still calls coding-worker tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Active coding worker: Codex | Claude | GrokBuild | Cline
JEV_CODING_STRATEGY=Codex

# Worker CLIs authenticate with subscriptions (run once in a terminal):
#   Codex      — codex login          (ChatGPT)
#   Claude     — claude auth login    (Claude Pro/Max/Team/Enterprise)
#   GrokBuild  — grok login           (SuperGrok / X Premium+)
#   Cline      — cline auth           (Cline / ClinePass)
# Do not set worker API keys. Do not commit secrets.

# Optional executable overrides when PATH / PATHEXT / npm-global auto-resolve is not enough.
# Windows npm globals (e.g. %AppData%\npm\cline.cmd) are found automatically.
# CODEX_EXECUTABLE=codex
# CLAUDE_EXECUTABLE=claude
# GROK_EXECUTABLE=grok
# CLINE_EXECUTABLE=cline
# Cline:ExecutablePath can also be set in appsettings (same as CLINE_EXECUTABLE).
# CODEX_DEFAULT_SANDBOX=workspace-write
# CODEX_TIMEOUT_SECONDS=300
