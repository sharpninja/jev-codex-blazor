{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jev": {
    "Name": "Jev",
    "PersonaDirectory": "",
    "CodingStrategy": "Codex"
  },
  "Claude": {
    "ExecutablePath": "claude",
    "PermissionMode": "acceptEdits",
    "AllowedTools": "Read,Edit,Bash",
    "OutputFormat": "json",
    "TimeoutSeconds": 300
  },
  "GrokBuild": {
    "ExecutablePath": "grok",
    "OutputFormat": "streaming-json",
    "AlwaysApprove": true,
    "TimeoutSeconds": 300
  },
  "Cline": {
    "ExecutablePath": "cline",
    "Yolo": true,
    "Json": true,
    "AutoApprove": true,
    "TimeoutSeconds": 300
  },
  "Codex": {
    "ExecutablePath": "codex",
    "DefaultSandbox": "workspace-write",
    "AskForApproval": "never",
    "SkipGitRepoCheck": true,
    "UseJsonEvents": true,
    "TimeoutSeconds": 300,
    "DefaultWorkspaceRoot": "",
    "AllowDangerousSandbox": false
  }
}
