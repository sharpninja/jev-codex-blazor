{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents.AI": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jev": {
    "Name": "Jev",
    "Model": "gpt-4o-mini",
    "PersonaDirectory": "",
    "UseFallbackChatClient": false,
    "CodingStrategy": "Codex"
  },
  "Claude": {
    "ExecutablePath": "claude",
    "PermissionMode": "acceptEdits",
    "AllowedTools": "Read,Edit,Bash",
    "OutputFormat": "json",
    "TimeoutSeconds": 300
  },
  "GrokBuild": {
    "ExecutablePath": "grok",
    "OutputFormat": "streaming-json",
    "AlwaysApprove": true,
    "TimeoutSeconds": 300
  },
  "Cline": {
    "ExecutablePath": "cline",
    "Yolo": true,
    "Json": true,
    "AutoApprove": true,
    "TimeoutSeconds": 300
  },
  // Optional Jev orchestration LLM only. Coding workers use subscription login, not this key.
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o-mini"
  },
  "Codex": {
    "ExecutablePath": "codex",
    "DefaultSandbox": "workspace-write",
    "AskForApproval": "never",
    "SkipGitRepoCheck": true,
    "UseJsonEvents": true,
    "TimeoutSeconds": 300,
    "DefaultWorkspaceRoot": "",
    "AllowDangerousSandbox": false
  }
}
